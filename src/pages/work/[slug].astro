---
import MainLayout from "../../layouts/Layout.astro";
import portfolioData from "../../data/portfolio.json";

export async function getStaticPaths() {
  const slug = t => t.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "");
  return portfolioData.work.projects.map(p => ({ params: { slug: slug(p.title) }, props: { project: p } }));
}

const { project } = Astro.props;
if (!project) return Astro.redirect("/404");
---

<MainLayout title={`${project.title} — Gonzalo`}>
  <section class="detail">
    <div class="container">
      <div class="section-head fade-in">
        <span class="section-head-dot"></span>
        <span class="section-head-label">Proyecto</span>
        <span class="section-head-scribble">
          <svg viewBox="0 0 160 10"><use href="#scribble"/></svg>
        </span>
      </div>

      <h1 class="detail-title fade-in">{project.title}</h1>
      <div class="detail-meta fade-in">
        <span class="detail-tag">{project.year}</span>
        <span class="detail-tag-fill">{project.technologies}</span>
      </div>

      <div class="detail-layout fade-in">
        <div class="detail-main">
          <p class="detail-desc">{project.longDescription}</p>
          <div class="detail-links">
            {project.liveUrl && <a href={project.liveUrl} target="_blank" class="btn btn-primary">Ver sitio en vivo</a>}
            {project.githubUrl && <a href={project.githubUrl} target="_blank" class="btn btn-outline">GitHub</a>}
          </div>
        </div>
        <aside class="detail-side">
          {project.features?.length > 0 && (
            <div class="detail-box">
              <h3 class="detail-box-title">Características</h3>
              <ul class="detail-list">
                {project.features.map(f => <li>{f}</li>)}
              </ul>
            </div>
          )}
          {project.metrics?.length > 0 && (
            <div class="detail-box detail-box-accent">
              <h3 class="detail-box-title">Métricas</h3>
              <ul class="detail-list">
                {project.metrics.map(m => <li>{m}</li>)}
              </ul>
            </div>
          )}
        </aside>
      </div>

      <div class="detail-back fade-in">
        <a href="/#work">← Volver a trabajos</a>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .detail { padding: 10rem 0 6rem; }
  .detail-title { font-size: clamp(2.5rem, 5vw, 4rem); font-weight: 800; margin-bottom: 1rem; line-height: 1.1; letter-spacing: -0.02em; }

  .detail-meta { display: flex; gap: 0.5rem; margin-bottom: 3rem; flex-wrap: wrap; }
  .detail-tag { padding: 0.3rem 0.9rem; border: 1px solid var(--border); border-radius: 6px; font-weight: 600; font-size: 0.8rem; }
  .detail-tag-fill { padding: 0.3rem 0.9rem; background: var(--accent-soft); color: var(--accent); border-radius: 6px; font-weight: 600; font-size: 0.8rem; }

  .detail-layout { display: grid; grid-template-columns: 1fr 300px; gap: 3rem; margin-bottom: 4rem; align-items: start; }
  .detail-desc { font-size: 1.15rem; line-height: 1.7; margin-bottom: 2.5rem; max-width: 65ch; }
  .detail-links { display: flex; gap: 0.75rem; flex-wrap: wrap; }

  .detail-side { display: flex; flex-direction: column; gap: 1.25rem; }

  .detail-box { border: 1px solid var(--border); border-radius: var(--radius); padding: 1.5rem; box-shadow: var(--shadow-sm); }
  .detail-box-accent { background: var(--accent-soft); border-color: var(--accent); }

  .detail-box-title { font-size: 1.1rem; font-weight: 700; margin-bottom: 1rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--border); }

  .detail-list { list-style: none; padding: 0; }
  .detail-list li { margin-bottom: 0.5rem; font-size: 0.9rem; display: flex; gap: 0.5rem; line-height: 1.4; }
  .detail-list li::before { content: "→"; color: var(--accent); font-weight: 700; flex-shrink: 0; }

  .detail-back { border-top: 1px solid var(--border); padding-top: 2rem; }
  .detail-back a { font-weight: 500; color: var(--text-muted); font-size: 0.9rem; transition: color 0.2s; }
  .detail-back a:hover { color: var(--accent); }

  @media (max-width: 1024px) {
    .detail-layout { grid-template-columns: 1fr; gap: 2rem; }
  }

  @media (max-width: 768px) {
    .detail { padding-top: 8rem; }
    .detail-title { font-size: 2.2rem; }
  }
</style>
