---
import MainLayout from "../layouts/Layout.astro";
---

<MainLayout title="404 — Página no encontrada">
  <section class="error">
    <div class="container">
      <div class="error-content fade-in">
        <h1 class="error-code">404</h1>
        <div class="error-scribble" aria-hidden="true">
          <svg viewBox="0 0 160 10"><use href="#scribble"/></svg>
        </div>
        <p class="error-msg">Vaya, esta página no existe.</p>
        <a href="/" class="btn btn-primary">Volver al inicio</a>
        <div class="error-links">
          <a href="/#work" class="error-link">Ver trabajos</a>
          <a href="/#contact" class="error-link">Contacto</a>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .error { min-height: 80vh; display: flex; align-items: center; justify-content: center; text-align: center; }
  .error-content { max-width: 400px; }

  .error-code { font-size: 7rem; font-weight: 800; line-height: 1; color: var(--accent); margin-bottom: 0; }
  .error-scribble { color: var(--accent); opacity: 0.25; width: 120px; height: 10px; margin: 0.5rem auto 1.5rem; }
  .error-scribble svg { width: 100%; height: 100%; display: block; }

  .error-msg { font-size: 1.05rem; color: var(--text-muted); margin-bottom: 2rem; }
  .error-links { display: flex; gap: 1.5rem; justify-content: center; margin-top: 1.5rem; }
  .error-link { font-size: 0.85rem; font-weight: 500; color: var(--text-muted); transition: color 0.2s; }
  .error-link:hover { color: var(--accent); }

  @media (max-width: 768px) {
    .error-code { font-size: 5rem; }
    .error-links { flex-direction: column; gap: 0.75rem; }
  }
</style>
