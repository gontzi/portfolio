---
import portfolioData from "../data/portfolio.json";
const { philosophy } = portfolioData;
---

<section class="section section-alt">
  <div class="container">
    <div class="section-head fade-in">
      <span class="section-head-dot"></span>
      <span class="section-head-label">{philosophy.title}</span>
      <span class="section-head-scribble">
        <svg viewBox="0 0 160 10"><use href="#scribble"/></svg>
      </span>
    </div>
    <div class="phil-grid">
      {philosophy.values.map((v, i) => (
        <div class="phil-card fade-in" style={`transition-delay: ${i * 0.1}s`}>
          <div class="phil-num">{String(i + 1).padStart(2, "0")}</div>
          <h3 class="phil-title">{v.title}</h3>
          <p class="phil-tagline">{v.tagline}</p>
          <p class="phil-desc">{v.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .phil-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }

  .phil-card {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 2rem;
    background: var(--bg-card);
    box-shadow: var(--shadow-sm);
    transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .phil-card:hover {
    border-color: var(--accent);
    box-shadow: 0 6px 20px rgba(120,162,210,0.12), 0 0 0 1px var(--accent);
    transform: translateY(-2px);
  }

  .phil-num { font-size: 2.25rem; font-weight: 700; color: var(--accent); line-height: 1; margin-bottom: 0.75rem; }

  .phil-title { font-size: 1.3rem; font-weight: 700; margin-bottom: 0.35rem; }
  .phil-tagline { font-size: 0.85rem; font-weight: 600; color: var(--accent); margin-bottom: 0.75rem; }
  .phil-desc { font-size: 0.9rem; color: var(--text-muted); line-height: 1.65; }

  @media (max-width: 768px) {
    .phil-grid { grid-template-columns: 1fr; }
    .phil-card { padding: 1.5rem; }
    .phil-num { font-size: 1.8rem; }
  }
</style>
