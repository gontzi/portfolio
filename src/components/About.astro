---
import portfolioData from "../data/portfolio.json";
const { about } = portfolioData;
---

<section id="about" class="section">
  <div class="container">
    <div class="section-head fade-in">
      <span class="section-head-dot"></span>
      <span class="section-head-label">{about.title}</span>
      <span class="section-head-scribble">
        <svg viewBox="0 0 160 10"><use href="#scribble"/></svg>
      </span>
    </div>
    {about.paragraphs.map((p, i) => (
      <p class="about-text fade-in" style={`transition-delay: ${i * 0.12}s`}>{p}</p>
    ))}
    <div class="about-tech fade-in">
      {about.technologies.map(t => <span class="tech-tag">{t}</span>)}
    </div>
  </div>
</section>

<style>
  .about-text { font-size: 1.05rem; line-height: 1.75; max-width: 58ch; margin-bottom: 1.5rem; color: var(--text); }
  .about-text:last-of-type { margin-bottom: 0; }

  .about-tech { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 2.5rem; padding-top: 2rem; border-top: 1px solid var(--border); }

  .tech-tag {
    padding: 0.35rem 1rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-muted);
    transition: all 0.2s ease;
  }

  .tech-tag:hover { border-color: var(--accent); color: var(--accent); background: var(--accent-soft); }
</style>
