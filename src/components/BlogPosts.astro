---
const res = await fetch("https://refuge.azaldev.com/api/posts.json");
const data = await res.json();
const posts = data.latestPosts.slice(0, 3);
---

<section class="section">
  <div class="container">
    <div class="section-head fade-in">
      <span class="section-head-dot"></span>
      <span class="section-head-label">Blog</span>
      <span class="section-head-scribble">
        <svg viewBox="0 0 160 10"><use href="#scribble"/></svg>
      </span>
    </div>
    <div class="posts-grid">
      {posts.map((post, i) => (
        <a
          href={`https://refuge.azaldev.com/blog/${post.slug}`}
          target="_blank"
          class="post-card fade-in"
          style={`transition-delay: ${i * 0.1}s`}
        >
          <div class="post-card-accent"></div>
          <div class="post-card-body">
            <span class="post-category">{post.data.category}</span>
            <h3 class="post-title">{post.data.title}</h3>
            <p class="post-desc">{post.data.description}</p>
            <div class="post-footer">
              <span class="post-date">
                {new Date(post.data.publishDate).toLocaleDateString("es-ES", {
                  year: "numeric", month: "short", day: "numeric",
                })}
              </span>
              <span class="post-more">
                Leer más
                <svg class="post-arrow" width="14" height="10" viewBox="0 0 14 10" fill="none">
                  <path d="M1 5h10M8 1l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .posts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .post-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-card);
    text-decoration: none;
    color: inherit;
    box-shadow: var(--shadow-sm);
    transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    overflow: hidden;
  }

  .post-card:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow-lg);
    transform: translateY(-3px);
  }

  .post-card-accent {
    height: 4px;
    background: var(--accent);
    flex-shrink: 0;
  }

  .post-card-body {
    padding: 1.5rem;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .post-category {
    font-size: 0.7rem;
    text-transform: uppercase;
    color: var(--accent);
    letter-spacing: 0.12em;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .post-title {
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: 0.65rem;
    line-height: 1.3;
  }

  .post-card:hover .post-title {
    color: var(--accent);
  }

  .post-desc {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.6;
    flex: 1;
    margin-bottom: 1.25rem;
  }

  .post-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .post-date {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .post-more {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent);
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .post-arrow {
    transition: transform 0.25s ease;
  }

  .post-card:hover .post-arrow {
    transform: translateX(3px);
  }

  @media (max-width: 768px) {
    .posts-grid {
      grid-template-columns: 1fr;
    }

    .post-card-body {
      padding: 1.25rem;
    }

    .post-title {
      font-size: 1.05rem;
    }
  }
</style>

<script>
  setTimeout(() => {
    document.querySelectorAll(".posts-grid .fade-in").forEach((el, i) => {
      setTimeout(() => el.classList.add("visible"), i * 120);
    });
  }, 200);
</script>
