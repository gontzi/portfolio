---
import portfolioData from "../data/portfolio.json";
const { contact, personal } = portfolioData;
---

<footer class="footer">
  <div class="container">
    <div class="footer-inner">
      <div class="footer-left">
        <img src="/me.png" alt="Gonzalo" class="footer-logo" />
        <span class="footer-name">{personal.name}</span>
      </div>
      <div class="footer-right">
        <span class="footer-text">{contact.footer}</span>
        <span class="footer-year">&copy; {new Date().getFullYear()}</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer { padding: 3rem 0; border-top: 1px solid var(--border); }
  .footer-inner { display: flex; justify-content: space-between; align-items: center; gap: 2rem; }

  .footer-left { display: flex; align-items: center; gap: 0.6rem; }
  .footer-logo { width: 28px; height: 28px; border-radius: 50%; border: 1px solid var(--border); object-fit: cover; }
  .footer-name { font-family: var(--font-display); font-weight: 600; font-size: 0.95rem; }

  .footer-right { display: flex; align-items: center; gap: 1.5rem; }
  .footer-text { font-size: 0.8rem; color: var(--text-muted); font-style: italic; }
  .footer-year { font-size: 0.75rem; color: var(--text-muted); }

  @media (max-width: 768px) {
    .footer-inner { flex-direction: column; text-align: center; gap: 1rem; }
    .footer-right { flex-direction: column; gap: 0.3rem; }
  }
</style>
