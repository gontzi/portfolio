---
import portfolioData from "../data/portfolio.json";
const { work } = portfolioData;
const slug = t => t.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "");
---

<section id="work" class="section section-alt">
  <div class="container">
    <div class="section-head fade-in">
      <span class="section-head-dot"></span>
      <span class="section-head-label">{work.title}</span>
      <span class="section-head-scribble">
        <svg viewBox="0 0 160 10"><use href="#scribble"/></svg>
      </span>
    </div>
    <p class="work-intro fade-in">{work.description}</p>
    <div class="work-grid">
      {work.projects.map(p => (
        <a href={`/work/${slug(p.title)}`} class="work-card fade-in">
          <div class="work-card-accent"></div>
          <div class="work-card-body">
            <div class="work-card-head">
              <h3 class="work-card-title">{p.title}</h3>
              <span class="work-card-year">{p.year}</span>
            </div>
            <p class="work-card-desc">{p.description}</p>
            <span class="work-card-more">
              Ver proyecto
              <svg class="work-arrow" width="14" height="10" viewBox="0 0 14 10" fill="none">
                <path d="M1 5h10M8 1l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .work-intro { font-size: 1rem; color: var(--text-muted); margin-bottom: 2.5rem; max-width: 50ch; line-height: 1.6; }

  .work-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.25rem; }

  .work-card {
    display: flex; flex-direction: column;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-card);
    text-decoration: none; color: inherit;
    box-shadow: var(--shadow-sm);
    transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    overflow: hidden;
  }

  .work-card:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow-lg);
    transform: translateY(-3px);
  }

  .work-card-accent { height: 4px; background: var(--accent); flex-shrink: 0; }

  .work-card-body { padding: 1.75rem; flex: 1; display: flex; flex-direction: column; }

  .work-card-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.65rem;
  }

  .work-card-title { font-size: 1.3rem; font-weight: 700; transition: color 0.3s ease; }
  .work-card:hover .work-card-title { color: var(--accent); }

  .work-card-year { font-size: 0.8rem; font-weight: 600; color: var(--text-muted); }

  .work-card-desc {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.6;
    flex: 1;
    margin-bottom: 1rem;
  }

  .work-card-more {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent);
    margin-top: auto;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .work-arrow { transition: transform 0.25s ease; }
  .work-card:hover .work-arrow { transform: translateX(4px); }

  @media (max-width: 768px) {
    .work-grid { grid-template-columns: 1fr; }
    .work-card-body { padding: 1.25rem; }
    .work-card-title { font-size: 1.1rem; }
  }
</style>
