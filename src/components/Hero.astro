---
import portfolioData from "../data/portfolio.json";
const { personal, hero } = portfolioData;
---

<section class="hero">
  <div class="container">
    <div class="hero-layout">
      <div class="hero-main fade-in">
        <div class="hero-intro">
          <span class="hero-intro-bar"></span>
          <span class="hero-status">{hero.availability}</span>
        </div>
        <h1 class="hero-name">{personal.name}</h1>
        <div class="hero-scribble" aria-hidden="true">
          <svg viewBox="0 0 240 10">
            <use href="#scribble-long"/>
          </svg>
        </div>
        <div class="hero-title">{personal.title}</div>
        <p class="hero-tagline">{personal.tagline}</p>
        <div class="hero-actions">
          <a href={personal.social.linkedin} target="_blank" class="btn btn-primary">{hero.buttons.linkedin}</a>
          <a href="#work" class="btn btn-outline">{hero.buttons.experience}</a>
          <a href="#contact" class="btn btn-outline">{hero.buttons.contact}</a>
        </div>
      </div>
      <div class="hero-visual fade-in">
        <div class="hero-blob" aria-hidden="true">
          <svg viewBox="0 0 220 220" fill="none">
            <circle cx="110" cy="110" r="110" fill="currentColor" opacity="0.06"/>
            <circle cx="90" cy="90" r="70" fill="currentColor" opacity="0.04"/>
          </svg>
          <img src="/me.png" alt="Gonzalo Azaldegi" class="hero-logo" />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 85vh;
    display: flex;
    align-items: center;
    padding: 8rem 0 5rem;
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: "";
    position: absolute;
    top: -30%;
    right: -8%;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(120,162,210,0.06) 0%, transparent 65%);
    pointer-events: none;
  }

  .hero-layout {
    display: grid;
    grid-template-columns: 1fr 200px;
    gap: 3rem;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .hero-intro {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.75rem;
  }

  .hero-intro-bar {
    display: block;
    width: 18px;
    height: 2px;
    background: var(--accent);
    flex-shrink: 0;
  }

  .hero-status {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .hero-name {
    font-size: clamp(3.5rem, 7vw, 5.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    margin-bottom: 0.15rem;
  }

  .hero-scribble {
    color: var(--accent);
    opacity: 0.35;
    width: 180px;
    height: 10px;
    margin: 0.65rem 0 0.85rem;
  }

  .hero-scribble svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .hero-title {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }

  .hero-tagline {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--text-muted);
    max-width: 48ch;
    margin-bottom: 2.25rem;
  }

  .hero-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .hero-visual {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero-blob {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-blob svg {
    position: absolute;
    width: 220px;
    height: 220px;
    color: var(--accent);
  }

  .hero-logo {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    border: 2px solid var(--border);
    position: relative;
    z-index: 1;
    background: var(--bg);
    box-shadow: var(--shadow-sm);
    object-fit: cover;
  }

  @media (max-width: 768px) {
    .hero {
      min-height: auto;
      padding: 7rem 0 3rem;
    }

    .hero-layout {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 2rem;
    }

    .hero-visual {
      order: -1;
    }

    .hero-logo {
      width: 80px;
      height: 80px;
    }

    .hero-blob svg {
      width: 180px;
      height: 180px;
    }

    .hero-scribble {
      margin: 0.5rem auto 0.75rem;
    }

    .hero-tagline {
      margin-left: auto;
      margin-right: auto;
    }

    .hero-actions {
      justify-content: center;
    }
  }
</style>

<script>
  setTimeout(() => {
    document.querySelectorAll(".hero .fade-in").forEach((el, i) => {
      setTimeout(() => el.classList.add("visible"), 200 + i * 180);
    });
  }, 100);
</script>
