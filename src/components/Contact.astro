---
import portfolioData from "../data/portfolio.json";
const { contact, personal } = portfolioData;
---

<section id="contact" class="section">
  <div class="container">
    <div class="section-head fade-in">
      <span class="section-head-dot"></span>
      <span class="section-head-label">{contact.title}</span>
      <span class="section-head-scribble">
        <svg viewBox="0 0 160 10"><use href="#scribble"/></svg>
      </span>
    </div>
    <p class="contact-message fade-in">{contact.message}</p>
    <div class="contact-row fade-in">
      <a href={personal.social.linkedin} target="_blank" class="contact-item">
        <span class="contact-char">L</span>
        <span class="contact-name">{contact.linkedinLabel}</span>
        <span class="contact-detail">{contact.linkedinSub}</span>
        <span class="contact-hint">↗</span>
      </a>
      <a href={`mailto:${personal.email}`} class="contact-item">
        <span class="contact-char">@</span>
        <span class="contact-name">{contact.emailLabel}</span>
        <span class="contact-detail">{personal.email}</span>
      </a>
      <a href={personal.social.github} target="_blank" class="contact-item">
        <span class="contact-char">G</span>
        <span class="contact-name">{contact.githubLabel}</span>
        <span class="contact-detail">{contact.githubSub}</span>
        <span class="contact-hint">↗</span>
      </a>
      <a href={personal.social.malt} target="_blank" class="contact-item">
        <span class="contact-char">M</span>
        <span class="contact-name">{contact.maltLabel}</span>
        <span class="contact-detail">{contact.maltSub}</span>
        <span class="contact-hint">↗</span>
      </a>
    </div>
  </div>
</section>

<style>
  .contact-message { font-size: 1.05rem; line-height: 1.6; color: var(--text-muted); max-width: 50ch; margin-bottom: 2.5rem; }

  .contact-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }

  .contact-item {
    display: flex;
    flex-direction: column;
    padding: 1.5rem 1.25rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    color: inherit;
    position: relative;
    overflow: hidden;
    background: var(--bg-card);
    transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .contact-item:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
  }

  .contact-char {
    font-family: var(--font-display);
    font-size: 2.4rem;
    font-weight: 700;
    color: var(--accent);
    line-height: 1;
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .contact-item:hover .contact-char { transform: translateY(-3px); }

  .contact-name {
    font-size: 0.85rem;
    font-weight: 600;
    margin-top: 0.75rem;
    transition: color 0.3s ease;
  }

  .contact-item:hover .contact-name { color: var(--accent); }

  .contact-detail {
    font-size: 0.7rem;
    color: var(--text-muted);
    margin-top: 0.15rem;
    line-height: 1.3;
  }

  .contact-hint {
    position: absolute;
    top: 0.85rem;
    right: 1rem;
    font-size: 0.85rem;
    color: var(--accent);
    opacity: 0;
    transform: translateX(-4px);
    transition: all 0.3s ease;
  }

  .contact-item:hover .contact-hint { opacity: 1; transform: translateX(0); }

  @media (max-width: 768px) {
    .contact-row { grid-template-columns: repeat(2, 1fr); }
    .contact-item { padding: 1.25rem 1rem 1rem; }
    .contact-char { font-size: 2rem; }
    .contact-hint { display: none; }
  }
</style>
