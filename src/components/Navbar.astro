---
import portfolioData from "../data/portfolio.json";
const { personal, navigation } = portfolioData;
---

<nav class="nav" id="navbar">
  <div class="container">
    <div class="nav-inner">
      <a href="/" class="nav-logo">
        <img src="/me.png" alt="Gonzalo" class="nav-logo-img" />
        <span class="nav-logo-text">{personal.name}</span>
      </a>
      <div class="nav-right">
        <ul class="nav-links">
          {navigation.map(item => (
            <li><a href={`#${item.target}`} class="nav-link">{item.label}</a></li>
          ))}
        </ul>
        <a href={personal.social.linkedin} target="_blank" class="nav-cta">LinkedIn</a>
        <button class="menu-toggle" id="menu-toggle" aria-label="Menú">
          <span></span><span></span>
        </button>
      </div>
    </div>
  </div>
</nav>

<div class="mobile-menu" id="mobile-menu">
  <nav class="mobile-nav">
    {navigation.map(item => (
      <a href={`#${item.target}`} class="mobile-link">{item.label}</a>
    ))}
    <a href={personal.social.linkedin} target="_blank" class="mobile-link mobile-link-accent">LinkedIn</a>
  </nav>
</div>

<style>
  .nav { position: fixed; top: 0; left: 0; right: 0; z-index: 100; padding: 1rem 0; transition: all 0.3s; }
  .nav.scrolled { background: rgba(255,248,240,0.92); backdrop-filter: blur(8px); box-shadow: 0 1px 4px rgba(0,0,0,0.06); }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; }
  .nav-logo { display: flex; align-items: center; gap: 0.6rem; }
  .nav-logo-img { width: 32px; height: 32px; border-radius: 50%; border: 1.5px solid var(--border); object-fit: cover; }
  .nav-logo-text { font-family: var(--font-display); font-weight: 600; font-size: 1.1rem; }
  .nav-right { display: flex; align-items: center; gap: 1.5rem; }
  .nav-links { display: flex; list-style: none; gap: 0.25rem; }
  .nav-link { padding: 0.4rem 0.8rem; font-size: 0.85rem; font-weight: 500; color: var(--text-muted); border-radius: 8px; transition: all 0.2s; }
  .nav-link:hover { color: var(--text); background: var(--accent-soft); }
  .nav-cta { padding: 0.4rem 1.2rem; font-size: 0.85rem; font-weight: 600; background: var(--accent); color: #fff; border-radius: 8px; transition: all 0.2s ease; }
  .nav-cta:hover { background: #5a8dc4; border-color: #5a8dc4; transform: translateY(-1px); box-shadow: var(--shadow-sm); }
  .menu-toggle { display: none; flex-direction: column; gap: 5px; background: none; border: none; cursor: pointer; padding: 4px; }
  .menu-toggle span { display: block; width: 20px; height: 2px; background: var(--text); border-radius: 2px; transition: all 0.3s; }
  .menu-toggle.active span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .menu-toggle.active span:nth-child(2) { transform: rotate(-45deg); }

  .mobile-menu { display: none; }

  @media (max-width: 768px) {
    .nav-links, .nav-cta { display: none; }
    .menu-toggle { display: flex; }
    .mobile-menu { display: flex; position: fixed; inset: 0; background: var(--bg); z-index: 99; align-items: center; justify-content: center; opacity: 0; visibility: hidden; transition: all 0.3s; }
    .mobile-menu.open { opacity: 1; visibility: visible; }
    .mobile-nav { display: flex; flex-direction: column; gap: 1.5rem; text-align: center; }
    .mobile-link { font-family: var(--font-display); font-size: 2rem; font-weight: 600; color: var(--text); }
    .mobile-link-accent { color: var(--accent); }
  }
</style>

<script>
  document.getElementById("navbar")?.classList.toggle("scrolled", window.scrollY > 40);
  window.addEventListener("scroll", () => document.getElementById("navbar")?.classList.toggle("scrolled", window.scrollY > 40));
  const t = document.getElementById("menu-toggle"), m = document.getElementById("mobile-menu");
  if (t && m) {
    t.addEventListener("click", () => { t.classList.toggle("active"); m.classList.toggle("open"); document.body.style.overflow = m.classList.contains("open") ? "hidden" : ""; });
    m.querySelectorAll("a").forEach(l => l.addEventListener("click", () => { t.classList.remove("active"); m.classList.remove("open"); document.body.style.overflow = ""; }));
  }
</script>
