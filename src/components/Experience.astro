---
import portfolioData from "../data/portfolio.json";
const { experience } = portfolioData;
---

<section id="experience" class="section">
  <div class="container">
    <div class="section-head fade-in">
      <span class="section-head-dot"></span>
      <span class="section-head-label">{experience.title}</span>
      <span class="section-head-scribble">
        <svg viewBox="0 0 160 10"><use href="#scribble"/></svg>
      </span>
    </div>
    <div class="exp-list">
      {experience.positions.map(p => (
        <div class="exp-card fade-in">
          <div class="exp-side"></div>
          <div class="exp-body">
            <div class="exp-head">
              <div>
                <h3 class="exp-title">{p.title}</h3>
                <span class="exp-company">{p.company}</span>
              </div>
              <span class="exp-badge">{p.period}</span>
            </div>
            <p class="exp-desc">{p.description}</p>
            <div class="exp-tech">{p.technologies}</div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .exp-list { display: flex; flex-direction: column; gap: 1.5rem; }

  .exp-card {
    display: flex;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-card);
    box-shadow: var(--shadow-sm);
    transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .exp-card:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow-md), 0 0 0 1px var(--accent);
  }

  .exp-side {
    width: 4px;
    background: var(--accent);
    flex-shrink: 0;
  }

  .exp-body { padding: 1.75rem 2rem; flex: 1; }

  .exp-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .exp-title { font-size: 1.25rem; font-weight: 700; margin-bottom: 0.1rem; }
  .exp-company { font-size: 0.85rem; font-weight: 500; color: var(--accent); }

  .exp-badge {
    padding: 0.25rem 0.75rem;
    font-size: 0.7rem;
    font-weight: 600;
    background: var(--accent-soft);
    color: var(--accent);
    border-radius: 6px;
    white-space: nowrap;
    font-family: var(--font-body);
  }

  .exp-desc {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.65;
    margin-bottom: 0.75rem;
    max-width: 58ch;
  }

  .exp-tech {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--text-muted);
    opacity: 0.55;
    letter-spacing: 0.02em;
  }

  @media (max-width: 768px) {
    .exp-head { flex-direction: column; gap: 0.5rem; }
    .exp-body { padding: 1.25rem; }
    .exp-title { font-size: 1.1rem; }
  }
</style>
